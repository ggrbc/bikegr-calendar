          "value": "(\"events\".\"start_local\" is null or date_trunc('minute', \"events\".\"start_local\") = \"events\".\"start_local\")\n        and (\"events\".\"end_local\" is null or date_trunc('minute', \"events\".\"end_local\") = \"events\".\"end_local\")"
