{
  "name": "bikegr-calendar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:smoke": "tsx src/db/smoke.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@auth/drizzle-adapter": "^1.11.3",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.1",
    "@vercel/functions": "^3.9.11",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.32.1",
    "rrule": "2.8.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  }
}
