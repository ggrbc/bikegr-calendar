# Copy to .env.local. Never commit real values.

# Postgres. `pnpm db:up` starts Docker Postgres with these values (BIKEGR_PG_PORT changes the port).
# A *.neon.tech host uses the Neon WebSocket driver; every other host uses postgres-js.
# Then: pnpm db:migrate && pnpm db:seed
DATABASE_URL=postgres://bikegr:bikegr@localhost:5432/bikegr

# Auth.js. Make a secret with: openssl rand -base64 32
# It also keys the rate-limit hashes (src/rate-limit); no separate secret is needed.
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google sign-in for Editors (docs/plans/google-login.md). Leave both empty to hide the Google
# button; the magic link always works. Locally, use the "local" OAuth client, whose redirect URI is
# http://localhost:3000/api/auth/callback/google. On Vercel: Production only.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend. Leave empty to log magic links to the console.
RESEND_API_KEY=
EMAIL_FROM=Bike GR Calendar <notifications@bikegr.org>

# Vercel Blob (store `uploads`) for `pnpm import:tockify` image copies. OIDC first: `vercel link`
# and `vercel env pull` write VERCEL_OIDC_TOKEN (about 12 h life); BLOB_STORE_ID names the store.
# Fallback: BLOB_READ_WRITE_TOKEN. With neither, the import runs and does not copy images.
VERCEL_OIDC_TOKEN=
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Cloudflare Turnstile for the public Submission form (/submit). With no keys, the form is closed.
# For `pnpm dev`, leave both keys empty and set TURNSTILE_TEST_KEYS to 1: Cloudflare's always-pass
# test keys (never on Vercel).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_TEST_KEYS=
